:root {
  --primary-color: #1b4332;
  --primary-hover: #2d6a4f;
  --bg-color: #f4f6f4;
  --card-bg: #ffffff;
  --text-main: #212529;
  --text-muted: #6c757d;
  --border-color: #dee2e6;
  --accent-gold: #f9d976;
}

body {
  margin: 0;
  padding: 0;
  background-color: var(--bg-color);
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  -webkit-font-smoothing: antialiased;
  box-sizing: border-box;
}

/* =========================================
   LANDING PAGE
   ========================================= */

.landing-page-shell {
  min-height: 100vh;
  background-color: #0b1c16;
  color: #ffffff;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  box-sizing: border-box;
}

/* =========================================
   LANDING PAGE STYLING
   ========================================= */

.landing-navbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 1rem var(--spacing-md);
  background: rgba(11, 28, 22, 0.96);
  backdrop-filter: blur(10px);
  position: sticky;
  top: 0;
  z-index: 1000;
  border-bottom: 1px solid rgba(255, 255, 255, 0.08);
}

/* Hamburger menu for mobile */
.hamburger {
  display: none;
  flex-direction: column;
  gap: 5px;
  cursor: pointer;
  padding: var(--spacing-sm);
}

/* Hamburger menu span */
.hamburger span {
  width: 25px;
  height: 3px;
  background: #ffffff;
  transition: all 0.3s ease;
}

/* Desktop navigation */
.landing-nav-links {
  display: flex;
  gap: 2.5rem;
}

.landing-nav-links a {
  color: #c2c9c5;
  text-decoration: none;
  font-weight: 500;
  font-size: 0.95rem;
  transition: color 0.2s;
}

.landing-nav-links a:hover,
.landing-nav-links a.active {
  color: #ffffff;
}

/* Landing page action buttons */
.landing-page-shell .auth-brand-name {
  color: #ffffff;
  font-size: 1.25rem;
  font-weight: 700;
  letter-spacing: -0.01em;
}

.landing-page-shell .auth-brand-name strong {
  color: #f9d976;
}

/* Hero section */
.landing-hero {
  position: relative;
  display: grid;
  grid-template-columns: 1.1fr 0.9fr;
  align-items: center;
  gap: 3rem;
  padding: 5rem var(--spacing-md);
  max-width: 100%;
  margin: 0 auto;
  background-image:
    linear-gradient(
      95deg,
      rgba(11, 28, 22, 0.88) 0%,
      rgba(17, 41, 32, 0.48) 52%,
      rgba(11, 28, 22, 0.25) 100%
    ), url('./assets/hero2.jpg');
  background-size: cover;
  background-position: center;
  border-bottom: 1px solid rgba(255, 255, 255, 0.08);
}

/* Subtitle */
.landing-subtitle {
  font-size: 1.05rem;
  color: #d0dbd4;
  line-height: 1.6;
  margin-bottom: 2rem;
  max-width: 500px;
}

/* Hero buttons */
.landing-hero-btns {
  display: flex;
  gap: 1rem;
  align-items: center;
  margin-bottom: 3rem;
  flex-wrap: wrap;
}

.landing-hero-btns .hero-primary {
  background: #f9d976;
  color: #1b4332;
  border: none;
  padding: 0.8rem 1.75rem;
  border-radius: 10px;
  font-weight: 700;
  font-size: 1rem;
  display: flex;
  align-items: center;
  gap: 0.5rem;
  cursor: pointer;
  transition: background 0.2s;
}

.landing-hero-btns .hero-primary:hover {
  background: #f5cc51;
}

.landing-hero-btns .hero-secondary {
  background: rgba(11, 28, 22, 0.72);
  border: 1px solid rgba(255, 255, 255, 0.25);
  color: #ffffff;
  padding: 0.8rem 1.5rem;
  border-radius: 10px;
  font-weight: 600;
  font-size: 1rem;
  display: flex;
  align-items: center;
  gap: 0.75rem;
  cursor: pointer;
}

/* Play icon */
.play-icon-wrap {
  width: 28px;
  height: 28px;
  background: #f9d976;
  color: #1b4332;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 0.75rem;
  font-weight: bold;
}

/* Social proof */
.landing-social-proof {
  display: flex;
  align-items: center;
  gap: 1rem;
  font-size: 0.85rem;
  color: #d0dbd4;
}

/* Proof avatars */
.proof-avatars {
  display: flex;
}

.avatar-dot {
  width: 32px;
  height: 32px;
  border-radius: 50%;
  border: 2px solid #0b1c16;
  margin-left: -10px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 0.85rem;
}

.avatar-dot:first-child {
  margin-left: 0;
}

/* Hero card preview */
.landing-hero-card-preview {
  background: rgba(27, 67, 50, 0.52);
  border: 1px solid rgba(183, 228, 199, 0.24);
  border-radius: 20px;
  padding: 2rem;
  display: flex;
  flex-direction: column;
  gap: 1.25rem;
  box-shadow: 0 20px 50px rgba(0, 0, 0, 0.45);
  backdrop-filter: blur(12px);
}

.preview-top-card {
  background: rgba(11, 28, 22, 0.86);
  border: 1px solid rgba(255, 255, 255, 0.12);
  border-radius: 12px;
  padding: 1.25rem;
  display: flex;
  flex-direction: column;
  gap: 0.6rem;
}

.preview-label {
  font-size: 0.8rem;
  color: #b7c6bd;
}

.preview-progress-track {
  width: 100%;
  height: 8px;
  background: #2d6a4f;
  border-radius: 4px;
  overflow: hidden;
}

.preview-progress-fill {
  height: 100%;
  background: #f9d976;
}

.preview-subtext {
  font-size: 0.75rem;
  color: #74c69d;
}

.preview-lesson-card {
  background: rgba(27, 67, 50, 0.92);
  border: 1px solid rgba(255, 255, 255, 0.16);
  border-radius: 12px;
  padding: 1rem 1.25rem;
  display: flex;
  align-items: center;
  gap: 1rem;
}

.lesson-play-icon {
  width: 40px;
  height: 40px;
  background: #f9d976;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #1b4332;
}

